tariff_data$Imbalance_Ratio <- round(tariff_data$Foreign_Tariff / tariff_data$US_Tariff, 2)
# 4. Calculate Percentage Difference
tariff_data$Percentage_Difference <- round(((tariff_data$Foreign_Tariff - tariff_data$US_Tariff) / tariff_data$US_Tariff) * 100, 2)
# 5. Print Full Dataset
print(tariff_data)
# 6. Identify Extreme Cases
extreme_cases <- subset(tariff_data, Imbalance_Ratio > 3)
print(extreme_cases)
# 7. Identify Cases Where the U.S. Tariff is Higher
us_advantage_cases <- subset(tariff_data, US_Tariff > Foreign_Tariff)
print(us_advantage_cases)
# 8. Summary Statistics
cat("Average Imbalance Ratio:", mean(tariff_data$Imbalance_Ratio), "\n")
cat("Maximum Imbalance:", max(tariff_data$Imbalance_Ratio), "(",
tariff_data$Country[which.max(tariff_data$Imbalance_Ratio)],
tariff_data$Product[which.max(tariff_data$Imbalance_Ratio)], ")\n")
# 9. Visualization - Barplot for All Tariffs
par(mfrow = c(1, 1))  # Reset plot layout
barplot(
height = t(as.matrix(tariff_data[, c("US_Tariff", "Foreign_Tariff")])),
beside = TRUE,
names.arg = paste(tariff_data$Country, "\n", tariff_data$Product),
col = c("blue", "red"),
main = "Tariff Imbalances: U.S. vs Foreign (April 2025)",
ylab = "Tariff Rate (%)",
ylim = c(0, 250),
cex.names = 0.8
)
legend("topright",
legend = c("U.S. Tariff", "Foreign Tariff"),
fill = c("blue", "red"))
# 10. Visualization - Imbalance Ratios
barplot(
tariff_data$Imbalance_Ratio,
names.arg = paste(tariff_data$Country, "\n", tariff_data$Product),
col = "purple",
main = "Tariff Imbalance Ratios (Foreign Tariff / U.S. Tariff)",
ylab = "Imbalance Ratio",
ylim = c(0, max(tariff_data$Imbalance_Ratio) + 2),
cex.names = 0.8
)
abline(h = mean(tariff_data$Imbalance_Ratio), col = "red", lty = 2)
legend("topright", legend = c("Avg Imbalance Ratio"), col = "red", lty = 2)
# 11. Scatter Plot - U.S. Tariffs vs Foreign Tariffs
plot(tariff_data$US_Tariff, tariff_data$Foreign_Tariff,
xlab = "U.S. Tariff (%)", ylab = "Foreign Tariff (%)",
main = "U.S. vs Foreign Tariffs",
col = "darkred", pch = 16)
# Add reference line (y = x) for equal tariffs
abline(a = 0, b = 1, col = "blue", lty = 2)
# 12. Horizontal Bar Chart - Imbalance Ratios
barplot(
tariff_data$Imbalance_Ratio,
names.arg = paste(tariff_data$Country, tariff_data$Product, sep = " - "),
col = "purple",
main = "Tariff Imbalance Ratios by Product",
xlab = "Imbalance Ratio",
horiz = TRUE,
las = 1
)
# 13. Histogram - Distribution of Tariff Imbalance Ratios
hist(tariff_data$Imbalance_Ratio,
col = "orange",
main = "Distribution of Imbalance Ratios",
xlab = "Imbalance Ratio",
breaks = 5)
# 14. Histogram - Distribution of U.S. and Foreign Tariffs
hist(tariff_data$US_Tariff,
col = "blue",
main = "Distribution of U.S. Tariffs",
xlab = "U.S. Tariff (%)",
breaks = 5)
hist(tariff_data$Foreign_Tariff,
col = "red",
main = "Distribution of Foreign Tariffs",
xlab = "Foreign Tariff (%)",
breaks = 5)
# 15. Additional Visualization - Line Graph of Tariff Trends (If Historical Data Available)
